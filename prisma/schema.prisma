// ============================================================
// INK MODEL
// Represents an ink family, for example Mimaki LUS-120.
// Individual colours and packaging variants are stored in InkProduct.
// ============================================================

model InkModel {
  id             String       @id @default(uuid()) @db.Uuid
  version        Int          @default(0)
  manufacturerId String       @db.Uuid
  inkName        String
  inkType        InkType
  notes          String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id])
  products       InkProduct[]

  // An ink name must be unique within its manufacturer.
  @@unique([manufacturerId, inkName])
}


// ============================================================
// INK PRODUCT
// Represents a purchasable colour and packaging configuration.
// Capacity is stored in millilitres for consistent calculations.
// ============================================================

model InkProduct {
  id            String           @id @default(uuid()) @db.Uuid
  version       Int              @default(0)
  inkModelId    String           @db.Uuid
  productCode   String?          @unique
  color         String
  packagingType InkPackagingType
  capacityMl    Int

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  inkModel      InkModel         @relation(fields: [inkModelId], references: [id])
  lots          InkLot[]
  purchaseItems InkPurchaseItem[]
}


// ============================================================
// INK LOT
// Represents a manufactured batch of an ink product.
// Expiry date and quantity are tracked at lot level.
// Quantity represents physical packages, not millilitres.
// ============================================================

model InkLot {
  id           String     @id @default(uuid()) @db.Uuid
  version      Int        @default(0)
  inkProductId String     @db.Uuid
  lotNumber    String
  expiryDate   DateTime   @db.Date
  quantity     Int        @default(0)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inkProduct   InkProduct @relation(fields: [inkProductId], references: [id])

  // A lot number must be unique within its ink product.
  @@unique([inkProductId, lotNumber])
}


// ============================================================
// INK PURCHASE
// Represents one customer purchase transaction, such as an invoice.
// A purchase can contain ink intended for multiple machines.
// ============================================================

model InkPurchase {
  id           String            @id @default(uuid()) @db.Uuid
  version      Int               @default(0)
  customerId   String            @db.Uuid
  purchasedAt  DateTime          @db.Date
  reference    String?
  currencyCode String?           @db.VarChar(3)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  customer     Customer          @relation(fields: [customerId], references: [id])
  items        InkPurchaseItem[]

  // Supports retrieving a customer's purchase history chronologically.
  @@index([customerId, purchasedAt])
}


// ============================================================
// INK PURCHASE ITEM
// One line in a purchase transaction. Each line identifies the
// physical machine the purchased ink is intended for.
// ============================================================

model InkPurchaseItem {
  id            String      @id @default(uuid()) @db.Uuid
  version       Int         @default(0)
  inkPurchaseId String      @db.Uuid
  machineId     String      @db.Uuid
  inkProductId  String      @db.Uuid
  quantity      Int
  unitPrice     Decimal?    @db.Decimal(12, 2)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  inkPurchase   InkPurchase @relation(fields: [inkPurchaseId], references: [id])
  machine       Machine     @relation(fields: [machineId], references: [id])
  inkProduct    InkProduct  @relation(fields: [inkProductId], references: [id])

  @@index([inkPurchaseId])
  @@index([machineId])
  @@index([inkProductId])
}
